/*
 * Generated by CMake from linker/firmware/memory_extra.incl.in, with values from src/common/layout.h.
 *
 * Replaces the SDK's empty memory_extra.incl, which memmap_default.ld includes right after
 * declaring FLASH (don't redeclare FLASH here). The firmware is linked at the start of flash;
 * the loader's rom_chain_image() maps slot A or B there (design D7), so it must fit one slot.
 */
ASSERT(__flash_binary_end <= ORIGIN(FLASH) + @LAYOUT_SLOT_SIZE@, "the firmware is larger than LAYOUT_SLOT_SIZE (src/common/layout.h)")
