/*
 * Generated by CMake from linker/loader/memory_extra.incl.in, with values from src/common/layout.h.
 *
 * Replaces the SDK's empty memory_extra.incl, which memmap_default.ld includes right after
 * declaring FLASH (don't redeclare FLASH here). The loader runs from the start of flash and
 * must fit its region (design D7).
 */
ASSERT(__flash_binary_end <= ORIGIN(FLASH) + @LAYOUT_LOADER_SIZE@, "the loader is larger than LAYOUT_LOADER_SIZE (src/common/layout.h)")
