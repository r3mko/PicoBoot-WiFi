;
; Test builds only (design D47, plan step L2): a passive capture of CS and CLK, sampled every PIO
; cycle (4 ns at 250 MHz), the rate at which length-based injection's detector would look at CLK.
; It runs in pio1 next to the counters and D44's recorder, and only reads its pins.
;
; JMP_PIN = CS; IN_BASE = CS, so each `in pins, 2` takes CS in bit 0 and CLK in bit 1. Shift left,
; autopush at 32 bits: 16 samples a word, the first in bits 31-30 (clk_summary.h). It starts at the
; first rising CLK edge inside a CS low period, the first transfer's first clock, and samples until
; the DMA has filled its buffer: then the full RX FIFO stalls it, until the firmware stops it after
; the injection.

.define PUBLIC CAPTURE_CS_PIN 4     ; U10 chip select and the EXI clock: clk_capture.c checks them
.define PUBLIC CAPTURE_CLK_PIN 5    ; against the injection's pins

.program clk_capture
start:
    wait 1 gpio CAPTURE_CS_PIN      ; CS high: before a transfer (or the console's first drive of an
    wait 0 gpio CAPTURE_CS_PIN      ; undriven CS), then a transfer starts
    wait 0 gpio CAPTURE_CLK_PIN     ; Its first rising CLK edge, not a CLK already high...
    wait 1 gpio CAPTURE_CLK_PIN
    jmp pin start                   ; ...with CS still low: a CLK glitch while CS is high doesn't count
.wrap_target
    in pins, 2                      ; One sample a cycle
.wrap
