;
; Test builds only (design D44): times every CS-high and CS-low period of the IPL read. Passive: it
; only reads CS (JMP_PIN) and CLK (IN_BASE), next to the counters in pio1. Shift left, autopush at
; 32 bits. Two words per CS low period, both counted down from all ones in steps of 2 cycles:
;   1. pushed as CS falls: bit 31 = CLK at that moment, bits 30-0 = the CS-high time before it;
;   2. pushed as CS rises: the CS-low time.
; Each period between two edges reads up to 6 cycles (24 ns at 250 MHz) short, as the loops start
; a few cycles after an edge; a period of 2 cycles reads 0 but still makes its own pair.

.program cs_timing
.wrap_target
    mov y, ~null                ; Count the CS-high time down from all ones
high:
    jmp pin high_count          ; CS still high: count
    in pins, 1                  ; CS fell: CLK's level now (D36's known limit)
    in y, 31                    ; The CS-high time: word 1
    mov x, ~null                ; Count the CS-low time
low:
    jmp pin low_end             ; CS rose: the period is over
    jmp x-- low
low_end:
    in x, 32                    ; The CS-low time: word 2
.wrap
high_count:
    jmp y-- high
    jmp high                    ; Y ran out (after 17 s): keep counting
